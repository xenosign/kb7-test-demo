{
  "title": "k6 Load Testing Results",
  "uid": "k6-load-testing-results",
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Virtual Users",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-k6"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-k6"
          },
          "query": "SELECT mean(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Requests (per interval)",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-k6"
      },
      "gridPos": {
        "h": 8,
