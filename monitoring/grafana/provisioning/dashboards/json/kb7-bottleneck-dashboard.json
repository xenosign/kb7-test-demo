{
  "title": "kb7 Bottleneck Demo",
  "uid": "kb7-bottleneck-demo",
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests/sec (by uri, status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"kb7-test-demo\"}[1m])) by (uri, status)",
          "legendFormat": "{{uri}} [{{status}}]"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"kb7-test-demo\"}[1m])) by (le, uri))",
          "legendFormat": "{{uri}} p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "HikariCP Active / Pending / Max Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"kb7-test-demo\"}",
          "legendFormat": "active"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"kb7-test-demo\"}",
          "legendFormat": "pending (waiting for a connection)"
        },
        {
          "expr": "hikaricp_connections_max{application=\"kb7-test-demo\"}",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 4,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"kb7-test-demo\", area=\"heap\"})",
          "legendFormat": "heap used"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Latency Avg",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_sum{application=\"kb7-test-demo\"}[$__range])) / sum(increase(http_server_requests_seconds_count{application=\"kb7-test-demo\"}[$__range]))",
          "instant": true,
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP Latency Median (p50)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(increase(http_server_requests_seconds_bucket{application=\"kb7-test-demo\"}[$__range])) by (le))",
          "instant": true,
          "legendFormat": "med"
        }
      ]
    },
    {
      "id": 7,
      "title": "HTTP Latency p90",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.90, sum(increase(http_server_requests_seconds_bucket{application=\"kb7-test-demo\"}[$__range])) by (le))",
          "instant": true,
          "legendFormat": "p90"
        }
      ]
    },
    {
      "id": 8,
      "title": "HTTP Latency p95",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(increase(http_server_requests_seconds_bucket{application=\"kb7-test-demo\"}[$__range])) by (le))",
          "instant": true,
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 9,
      "title": "HTTP Latency Max",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "max(max_over_time(http_server_requests_seconds_max{application=\"kb7-test-demo\"}[$__range]))",
          "instant": true,
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 10,
      "title": "k6 Load Test - http_req_duration (client-side)",
